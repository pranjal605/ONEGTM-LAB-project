# ---- Forager ----
FORAGER_API_KEY=
FORAGER_ACCOUNT_ID=

# ---- HubSpot (Private App token) ----
HUBSPOT_ACCESS_TOKEN=

# ---- Security ----
# Protects /api/* endpoints (send as header X-API-Secret)
ADMIN_API_KEY=
# Shared secret for HubSpot *workflow* webhooks (added to the URL as ?secret=...)
WEBHOOK_SECRET=
# Only if you use a HubSpot developer-app webhook subscription (signature v3)
HUBSPOT_CLIENT_SECRET=
# Your public Railway URL, e.g. https://my-app.up.railway.app (needed for signature check)
PUBLIC_BASE_URL=

# ---- Credit controls (Forager: detail=1, work email=5, phone=15 credits) ----
REVEAL_WORK_EMAIL=true
REVEAL_PHONE=true
MAX_CONTACTS_PER_COMPANY=5
MAX_SEARCH_PAGES=3

# ---- Job-title filter defaults (comma separated) ----
DEFAULT_TITLE_INCLUDE=CEO,Chief Executive Officer,CTO,Chief Technology Officer,Chief,VP,Vice President,Head of,Director
DEFAULT_TITLE_EXCLUDE=intern,assistant

# ---- Optional ----
CACHE_DIR=.cache
ENABLE_POLLER=false
POLL_INTERVAL_SECONDS=60
LOG_LEVEL=INFO
